# =========================================================================
# LS STUDIO DISCORD BOT - ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================
# Sao chep tep nay thanh .env va dien cac gia tri thuc te cua ban.
# TUYET DOI KHONG commit tep .env chua token that len Git repository!

# Discord Bot Token (Lay tu Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=your_discord_bot_token_here

# ID Server Discord (Mac dinh: 1542476657825419334 cho LS Studio Server)
GUILD_ID=1542476657825419334

# Discloud API Token (Tuy chon: dung cho commit_discloud.js)
DISCLOUD_TOKEN=your_discloud_token_here

# Duong dan tep ZIP deploy Discloud (Tuy chon)
DISCLOUD_ZIP_PATH=/sdcard/Download/LS_Studio_Bot_247.zip
