# =========================================================================
# LS STUDIO DISCORD BOT - ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================
# HƯỚNG DẪN / INSTRUCTIONS:
# 1. Sao chép file này thành .env:
#    cp .env.example .env
# 2. Điền các giá trị thực tế của bạn vào file .env vừa tạo.
# 3. TUYỆT ĐỐI KHÔNG commit file .env chứa token thật lên Git repository!
#    (File .env đã được bảo vệ tự động trong .gitignore)
# =========================================================================

# -------------------------------------------------------------------------
# 1. DISCORD BOT AUTHENTICATION (BẮT BUỘC / REQUIRED)
# -------------------------------------------------------------------------
# Discord Bot Token lấy từ Discord Developer Portal:
# https://discord.com/developers/applications -> Bot -> Reset Token / Copy Token
DISCORD_TOKEN=your_discord_bot_token_here

# ID Máy chủ Discord mục tiêu (Guild ID):
# Mặc định: 1542476657825419334 (LS Studio Official Server)
GUILD_ID=1542476657825419334

# Môi trường chạy (production | development | test)
NODE_ENV=production

# -------------------------------------------------------------------------
# 2. CẤU HÌNH THANH TOÁN VIETQR / NGÂN HÀNG (TÙY CHỌN / OPTIONAL)
# -------------------------------------------------------------------------
# Tên viết tắt ngân hàng thụ hưởng (MB, VCB, TCB, ACB, VPB, TPB, ...)
BANK_ID=MB

# Số tài khoản ngân hàng thụ hưởng nhận chuyển khoản VietQR
BANK_ACCOUNT_NO=844515133333

# Tên chủ tài khoản ngân hàng (Không dấu hoặc có dấu IN HOA)
BANK_ACCOUNT_NAME=VAN HUU PHAM NGUYEN

# -------------------------------------------------------------------------
# 3. CẤU HÌNH CLOUD HOSTING DISCLOUD (TÙY CHỌN / OPTIONAL)
# -------------------------------------------------------------------------
# Discloud API Token (Lấy từ bot Discloud qua lệnh .api / .token hoặc Web Dashboard)
DISCLOUD_TOKEN=your_discloud_token_here

# Discloud Application ID (ID ứng dụng bot trên Discloud)
DISCLOUD_APP_ID=1787827063185

# Đường dẫn tệp ZIP để tự động commit/deploy lên Discloud (Dùng cho commit_discloud.js)
DISCLOUD_ZIP_PATH=/sdcard/Download/LS_Studio_Bot_247.zip

# -------------------------------------------------------------------------
# 4. CẤU HÌNH MEDIA & ĐỒ HỌA ASSETS (TÙY CHỌN / OPTIONAL)
# -------------------------------------------------------------------------
# Thư mục xuất file ảnh banner, icon đã qua xử lý
MEDIA_OUTPUT_DIR=./media_output

# Đường dẫn file ảnh nền banner (dùng cho composite_bg.js)
BG_SRC_PATH=./assets/background.png

# Đường dẫn file ảnh logo (dùng cho composite_bg.js, resize_logo.js)
LOGO_SRC_PATH=./assets/logo.png

# Đường dẫn file icon server (dùng cho set_server_icon.js)
ICON_SRC_PATH=./assets/server_icon.png

